# Settings for scripts/delta. Copy this file to config.env and fill it in:
#     cp scripts/delta/config.env.example scripts/delta/config.env
# Keep one copy on your Mac and one on Delta. `sync.sh push` does not overwrite
# the Delta copy, and config.env is git-ignored.

# Your NCSA username. For ACCESS projects it is in your ACCESS profile, in the
# "Resource Provider Site Usernames" table at the bottom of the page.
NCSA_USER=""

# Slurm account to charge: the first column of the `accounts` command on Delta,
# e.g. "abcd-delta-gpu". The part before the first "-" (abcd) is your project
# directory under /projects, /work/hdd and /work/nvme. On Delta, setup_env.sh
# fills this in for you if you have exactly one account.
DELTA_ACCOUNT=""

# PyTorch module (Delta's Miniforge/conda GPU PyTorch for x86_64 + CUDA), pinned so a
# change of the site default doesn't change your jobs. List others with:
#     module avail pytorch-conda      (or `module spider pytorch`)
DELTA_PYTORCH_MODULE="pytorch-conda/2.8"

# Name of your Python venv, created under /work/nvme/<code>/$USER/venvs/.
DELTA_VENV_NAME="backdoor"

# Where `sync.sh push` puts this repo on Delta, relative to your Delta home (/u/$USER).
DELTA_REMOTE_DIR="backdoor-coding-agents"
