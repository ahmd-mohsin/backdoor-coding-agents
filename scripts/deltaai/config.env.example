# Settings for scripts/deltaai. Copy this file to config.env and fill it in:
#     cp scripts/deltaai/config.env.example scripts/deltaai/config.env
# Keep one copy on your Mac and one on DeltaAI. `sync.sh push` does not overwrite
# the DeltaAI copy, and config.env is git-ignored.

# Your NCSA username. For ACCESS projects it is in your ACCESS profile, in the
# "Resource Provider Site Usernames" table at the bottom of the page.
NCSA_USER=""

# Slurm account to charge: the first column of the `accounts` command on DeltaAI,
# e.g. "abcd-dtai-gh". The part before the first "-" (abcd) is your project
# directory under /projects, /work/hdd and /work/nvme. On DeltaAI, setup_env.sh
# fills this in for you if you have exactly one account.
DTAI_ACCOUNT=""

# PyTorch module, pinned so a change of the site default doesn't change your jobs.
# 2.10.0 (CUDA 12.9) is the current default and marked "production-tested".
# List others with: module avail python/miniforge3_pytorch
DTAI_PYTORCH_MODULE="python/miniforge3_pytorch/2.10.0"

# Name of your Python venv, created under /work/nvme/<code>/$USER/venvs/.
DTAI_VENV_NAME="backdoor"

# Where `sync.sh push` puts this repo on DeltaAI, relative to your DeltaAI home (/u/$USER).
DTAI_REMOTE_DIR="backdoor-coding-agents"
